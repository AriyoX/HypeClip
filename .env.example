# Optional. Start the dashboard from this checkout without any account credentials.
# The CLI reads .env from its working directory. Existing process values win.
# HYPECLIP_DASHBOARD_PORT=4177
# HYPECLIP_CAPTURE_LIMIT=2
# Leave these unset to use the model verified by setup-ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# HYPECLIP_PYTHON=C:/path/to/.venv/Scripts/python.exe
# HYPECLIP_FFMPEG=C:/path/to/ffmpeg.exe
# HYPECLIP_FFPROBE=C:/path/to/ffprobe.exe
# HYPECLIP_WHISPER_MODEL_PATH=C:/path/to/CTranslate2/snapshot
# HYPECLIP_HOME=C:/local/shared/HypeClip
# HYPECLIP_STREAMLINK=C:/path/to/streamlink.exe
# HYPECLIP_KOKORO_DIR=C:/path/to/kokoro-model-directory
# HYPECLIP_KOKORO_PYTHON=C:/path/to/kokoro/venv/Scripts/python.exe
# Optional if the Python media worker lives in a separate checkout.
# HYPECLIP_WORKER_ROOT=C:/path/to/clip-it
# FFmpeg aliases are recognized by individual legacy tools. Prefer HYPECLIP_* above.
# FFMPEG=C:/path/to/ffmpeg.exe
# FFPROBE=C:/path/to/ffprobe.exe
# HF_HOME=C:/path/to/huggingface-cache
# XDG_CACHE_HOME=C:/path/to/cache
# HF_HUB_OFFLINE=1
# OMP_NUM_THREADS=2
# On systems without LOCALAPPDATA, XDG_STATE_HOME sets the local state base.
# XDG_STATE_HOME=/path/to/state
# A source's optional feedEnv names a variable you choose for a private media feed.
# MY_CREATOR_FEED=
# For isolated tests set HYPECLIP_ISOLATED=1 in the calling shell before launch.
# HYPECLIP_STAGE_CONTROL, HYPECLIP_STAGE_PARENT and HYPECLIP_STAGE_CANCEL are
# private worker protocol fields assigned by the coordinator.

# Optional Twitch reader. See docs/monitor.md for token acquisition and validation.
TWITCH_USER_TOKEN=
# Single-channel "collect" command only. The monitor resolves each login.
TWITCH_BROADCASTER_ID=
# Optional YouTube Data API reader. Choose one. Neither is used to download media.
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=

# Future publishing only. Leave blank for all local watchlist and export commands.
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=
HYPECLIP_R2_ACCOUNT_ID=
HYPECLIP_R2_BUCKET=
HYPECLIP_R2_ACCESS_KEY_ID=
HYPECLIP_R2_SECRET_ACCESS_KEY=
HYPECLIP_R2_PUBLIC_URL=
# HYPECLIP_CHANNEL_REQUIREMENTS=Manual privacy or commercial disclosure required
